# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# --- TradeLocker / PlexyTrade DEMO ---------------------------------------------
TL_ENVIRONMENT=https://demo.tradelocker.com
TL_EMAIL=you@example.com
TL_PASSWORD=change-me
TL_SERVER=PLEXY
# Leave empty if you have one demo account; otherwise the account ID shown in TradeLocker
TL_ACC_NUM=

# --- Safety ----------------------------------------------------------------------
# Gimenez refuses to connect to anything but the demo server unless BOTH are set:
#   GIMENEZ_MODE=live  and  GIMENEZ_ALLOW_LIVE=YES   (and TL_ENVIRONMENT pointing at live)
GIMENEZ_MODE=demo
GIMENEZ_ALLOW_LIVE=NO

# --- Dashboard (port 8001): any user name + this password ------------------------
DASHBOARD_PASSWORD=

# --- Optional tuning ---------------------------------------------------------------
# How many markets it watches at once (it picks them itself)
WATCHLIST_SIZE=12
# Timeframes the research searches (1m-5m is the fastest allowed; true HFT is impossible over REST)
RESEARCH_TIMEFRAMES=5m,15m,1H
# Seconds of CPU per research run, and pause between runs
RESEARCH_CPU_SECONDS=900
RESEARCH_SLEEP_SECONDS=300
# Requests per second to TradeLocker (it also reads TradeLocker's published limits and uses half)
TL_REQUESTS_PER_SECOND=1.0
